    "preset",
    "lib",
    "docs",
    "pipeline.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node tools/build-bundle.mjs",
    "test": "node --test \"test/*.test.js\"",
    "verify": "node tools/verify.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-bundle",
    "agent-preset",
    "comfyui"
